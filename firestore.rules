rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function poolDoc(poolId) {
      return get(/databases/$(database)/documents/pools/$(poolId));
    }

    function isMember(poolId) {
      return isSignedIn() && request.auth.uid in poolDoc(poolId).data.memberUids;
    }

    function isCommissioner(poolId) {
      return isSignedIn() && request.auth.uid == poolDoc(poolId).data.commissionerUid;
    }

    // A non-member may add ONLY their own uid to memberUids (joining by pool ID).
    function isSelfJoin() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
        && request.resource.data.memberUids.toSet()
             == resource.data.memberUids.toSet().union([request.auth.uid].toSet());
    }

    function weekIsOpen(poolId, weekId) {
      let week = get(/databases/$(database)/documents/pools/$(poolId)/weeks/$(weekId)).data;
      return week.status == "open" && request.time < week.lockAt;
    }

    match /pools/{poolId} {
      // Uses resource.data (not a get() lookup) so it also works for the list query
      // "pools where memberUids contains me".
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if isSignedIn()
        && request.resource.data.commissionerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];
      allow update: if isCommissioner(poolId) || isSelfJoin();
      allow delete: if isCommissioner(poolId);

      match /weeks/{weekId} {
        allow read: if isMember(poolId);
        // Weeks are created, locked and scored by the sync worker (service account bypasses rules).
        // The commissioner may delete them, but only as part of deleting the pool.
        allow create, update: if false;
        allow delete: if isCommissioner(poolId);

        match /games/{gameId} {
          allow read: if isMember(poolId);
          allow create, update: if false;
          allow delete: if isCommissioner(poolId);
        }

        match /picks/{uid} {
          allow read: if isMember(poolId)
            && (request.auth.uid == uid || !weekIsOpen(poolId, weekId));
          allow create, update: if isMember(poolId)
            && request.auth.uid == uid
            && weekIsOpen(poolId, weekId)
            && request.resource.data.keys().hasAll(['selections', 'tiebreakerGuess', 'submittedAt']);
          allow delete: if isCommissioner(poolId);
        }

        match /results/{uid} {
          allow read: if isMember(poolId);
          allow create, update: if false;
          allow delete: if isCommissioner(poolId);
        }
      }

      match /standings/{uid} {
        allow read: if isMember(poolId);
        allow create, update: if false;
        allow delete: if isCommissioner(poolId);
      }
    }

    // Display names, so standings can show people instead of UIDs.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
